{
  "name": "arcane-guilds",
  "version": "0.1.0",
  "description": "Arcane Guilds — multiplayer web board game (iPad + desktop), Node + Socket.io",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "cards": "node scripts/card-report.js",
    "sim": "node scripts/sim/validate.js",
    "sim:quick": "node scripts/sim/validate.js 0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
